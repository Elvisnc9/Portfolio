---
// Temporary page body until each page is built in its own phase.
interface Props {
  label: string;
  title: string;
  text: string;
}

const { label, title, text } = Astro.props;
---

<section class="placeholder">
  <span class="mono-label" data-reveal>{label}</span>
  <h1 data-reveal data-reveal-delay="0.08">{title}</h1>
  <p data-reveal data-reveal-delay="0.16">{text}</p>
</section>

<style>
  .placeholder {
    min-height: 60vh;
    padding: 64px var(--gutter);
    display: grid;
    align-content: start;
    gap: 16px;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(48px, 9vw, 128px);
    line-height: 0.9;
    letter-spacing: var(--tracking-tight);
  }

  p {
    color: var(--muted);
    max-width: 40ch;
  }
</style>
