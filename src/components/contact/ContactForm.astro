---
// Project inquiry form. Sends by opening the visitor's email app with the brief
// pre-filled (no backend needed). To use a form service instead, listen for the
// cancelable "contact:send" event on the form, call preventDefault(), and POST
// event.detail.data yourself.
import Icon from '../Icon.astro';
import { site } from '../../data/site';

const types = ['Mobile app', 'Website', 'SaaS', 'AI integration', 'Something else'];
const timelines = ['ASAP', 'In 1–3 months', 'Just exploring'];
---

<form class="form" action={`mailto:${site.email}`} method="post" enctype="text/plain" novalidate data-contact-form data-email={site.email} data-reveal>
  <div class="row">
    <div class="field">
      <label for="cf-name">Your name</label>
      <input id="cf-name" name="name" type="text" placeholder="Jane Doe" autocomplete="name" required aria-describedby="cf-name-error" />
      <span class="error" id="cf-name-error" data-error-for="name"></span>
    </div>
    <div class="field">
      <label for="cf-email">Email</label>
      <input id="cf-email" name="email" type="email" placeholder="you@company.com" autocomplete="email" required aria-describedby="cf-email-error" />
      <span class="error" id="cf-email-error" data-error-for="email"></span>
    </div>
  </div>

  <div class="field field--company">
    <label for="cf-company">Company <span class="optional">(optional)</span></label>
    <input id="cf-company" name="company" type="text" placeholder="Where you work" autocomplete="organization" />
  </div>

  <fieldset>
    <legend>What are we building?</legend>
    <div class="chips">
      {
        types.map((t) => (
          <label class="chip chip--type">
            <input type="radio" name="type" value={t} checked={t === 'Mobile app'} />
            {t}
          </label>
        ))
      }
    </div>
  </fieldset>

  <fieldset>
    <legend>When do you need it?</legend>
    <div class="chips">
      {
        timelines.map((t) => (
          <label class="chip chip--time">
            <input type="radio" name="timeline" value={t} checked={t === 'In 1–3 months'} />
            {t}
          </label>
        ))
      }
    </div>
  </fieldset>

  <div class="field">
    <label for="cf-budget">Budget <span class="optional">(optional)</span></label>
    <input id="cf-budget" name="budget" type="text" placeholder="A rough range is fine" />
  </div>

  <div class="field">
    <label for="cf-message">Tell me about it</label>
    <textarea
      id="cf-message"
      name="message"
      placeholder="What are you building, who is it for, and where are you stuck?"
      required
      aria-describedby="cf-message-error"></textarea>
    <span class="error" id="cf-message-error" data-error-for="message"></span>
  </div>

  <button class="submit" type="submit">Send inquiry <Icon name="arrow-right" size={18} /></button>

  <div class="sent" role="status" hidden data-contact-sent>
    <strong>Your email app should be open with the brief filled in.</strong>
    Just hit send there. Nothing opened? Email me directly at
    <a href={`mailto:${site.email}`}>{site.email}</a>.
  </div>
</form>

<script>
  const messages: Record<string, string> = {
    name: 'Please add your name.',
    email: 'Please add an email I can reply to.',
    emailFormat: 'That email doesn’t look quite right.',
    message: 'Tell me a little about the project.',
  };

  document.addEventListener('astro:page-load', () => {
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    if (!form) return;

    const sent = form.querySelector<HTMLElement>('[data-contact-sent]')!;
    const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement;

    function setError(name: string, message: string) {
      const input = field(name);
      const slot = form!.querySelector<HTMLElement>(`[data-error-for="${name}"]`)!;
      slot.textContent = message;
      if (message) input.setAttribute('aria-invalid', 'true');
      else input.removeAttribute('aria-invalid');
    }

    function validate() {
      const errors: [string, string][] = [];
      const name = field('name');
      const email = field('email');
      const message = field('message');

      if (!name.value.trim()) errors.push(['name', messages.name]);
      if (!email.value.trim()) errors.push(['email', messages.email]);
      else if (!(email as HTMLInputElement).checkValidity()) errors.push(['email', messages.emailFormat]);
      if (!message.value.trim()) errors.push(['message', messages.message]);

      ['name', 'email', 'message'].forEach((n) => setError(n, errors.find(([k]) => k === n)?.[1] ?? ''));
      return errors;
    }

    // Clear a field's error as soon as it's edited
    ['name', 'email', 'message'].forEach((n) =>
      field(n).addEventListener('input', () => {
        if (field(n).getAttribute('aria-invalid')) setError(n, '');
      }),
    );

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const errors = validate();
      if (errors.length) {
        field(errors[0][0]).focus();
        return;
      }

      const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
      const subject = `New project: ${data.type} — ${data.name}`;
      const body = [
        'Hi Elvis,',
        '',
        data.message,
        '',
        '—',
        `Name: ${data.name}`,
        `Email: ${data.email}`,
        data.company ? `Company: ${data.company}` : null,
        `Project: ${data.type}`,
        `Timeline: ${data.timeline}`,
        data.budget ? `Budget: ${data.budget}` : null,
      ]
        .filter((line) => line !== null)
        .join('\n');
      const url = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

      // Extension point: a form service can cancel this and send `data` itself
      const proceed = form.dispatchEvent(new CustomEvent('contact:send', { cancelable: true, detail: { url, data } }));
      if (proceed) window.location.href = url;

      sent.hidden = false;
      sent.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  });
</script>

<style>
  .form {
    padding: 44px;
    display: flex;
    flex-direction: column;
    gap: 26px;
    border-radius: 36px;
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  label,
  legend {
    font-size: 14px;
    font-weight: 500;
  }

  .optional {
    font-weight: 400;
    color: var(--muted);
  }

  input[type='text'],
  input[type='email'],
  textarea {
    width: 100%;
    height: 56px;
    padding: 0 18px;
    border-radius: 16px;
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--text);
    font: 400 16px var(--font-body);
    transition:
      border-color 0.2s,
      background-color 0.2s;
  }

  textarea {
    height: 150px;
    padding: 16px 18px;
    resize: vertical;
  }

  input::placeholder,
  textarea::placeholder {
    color: #8a877f;
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--text);
    background: var(--surface);
  }

  [aria-invalid='true'] {
    border-color: #d93a12;
  }

  .error {
    font-size: 13px;
    color: #b42f0e;
  }

  .error:empty {
    display: none;
  }

  /* ---------- Chips (radio buttons) ---------- */
  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  legend {
    padding: 0;
    margin-bottom: 10px;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    height: 48px;
    padding: 0 20px;
    display: flex;
    align-items: center;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line);
    background: var(--surface);
    font-size: 15px;
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color 0.2s,
      border-color 0.2s,
      color 0.2s;
  }

  .chip:hover {
    border-color: var(--text);
  }

  .chip input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .chip:has(input:focus-visible) {
    outline: 2px solid var(--orange);
    outline-offset: 3px;
  }

  .chip--type:has(input:checked) {
    border-color: var(--orange);
    background: var(--orange);
    font-weight: 600;
  }

  .chip--time:has(input:checked) {
    border-color: var(--dark);
    background: var(--dark);
    color: var(--on-dark);
  }

  /* ---------- Submit + confirmation ---------- */
  .submit {
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--orange);
    color: var(--dark);
    font-weight: 700;
    font-size: 17px;
    transition: transform 0.2s;
  }

  .submit:hover {
    transform: translateY(-2px);
  }

  .submit :global(svg) {
    transition: transform 0.2s;
  }

  .submit:hover :global(svg) {
    transform: translateX(4px);
  }

  .sent {
    padding: 18px 20px;
    border-radius: 20px;
    background: var(--sky);
    font-size: 15px;
    line-height: 1.5;
  }

  .sent[hidden] {
    display: none;
  }

  .sent strong {
    display: block;
    margin-bottom: 4px;
  }

  .sent a {
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 600;
  }

  /* ========== Mobile ========== */
  @media (max-width: 640px) {
    .form {
      padding: 22px;
      gap: 20px;
      border-radius: 28px;
    }

    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }

    /* The mobile mockup leaves out Company */
    .field--company {
      display: none;
    }

    input[type='text'],
    input[type='email'] {
      height: 52px;
      padding: 0 16px;
      border-radius: 14px;
    }

    textarea {
      height: 140px;
      padding: 14px 16px;
      border-radius: 14px;
    }

    .chips {
      gap: 6px;
    }

    .chip {
      height: var(--tap);
      padding: 0 15px;
      font-size: 14px;
    }

    .submit {
      height: 58px;
      font-size: 16px;
    }
  }
</style>
