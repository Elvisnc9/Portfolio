---
import Icon from '../Icon.astro';
import { journey, startChapter } from '../../data/about';

const total = journey.length;
const pad = (n: number) => String(n).padStart(2, '0');
const pct = (i: number) => `${Math.round(((i + 1) / total) * 100)}%`;
const upNext = (i: number) =>
  i === total - 1 ? { label: 'NEXT CHAPTER', year: `${Number(journey[i].year) + 1} → ?` } : { label: 'UP NEXT', year: journey[i + 1].year };
---

<section id="journey" class="journey" data-start={startChapter} data-total={total}>
  <header class="head">
    <div class="title" data-reveal>
      <span class="pill">MY JOURNEY</span>
      <h2>How I<br />got here</h2>
    </div>

    <div class="stepper" data-reveal data-reveal-delay="0.1">
      <div class="progress-label">
        <span data-step-label>CHAPTER {pad(startChapter + 1)} OF {pad(total)}</span>
        <span><span data-pct-label>{pct(startChapter)}</span><span class="hide-mobile"> THROUGH</span></span>
      </div>
      <div class="bar" aria-hidden="true"><div class="bar-fill" data-bar style={`width: ${pct(startChapter)}`}></div></div>
      <div class="years" role="group" aria-label="Choose a year">
        {
          journey.map((ch, i) => (
            <button type="button" data-go={i} aria-pressed={i === startChapter ? 'true' : 'false'}>
              {ch.year}
            </button>
          ))
        }
      </div>
    </div>
  </header>

  <p class="visually-hidden" aria-live="polite" data-status></p>

  <div class="chapters">
    {
      journey.map((ch, i) => {
        const next = upNext(i);
        return (
          <div class="chapter" data-chapter={i} hidden={i !== startChapter}>
            <article class="story" style={`--shape: ${ch.shape}`} aria-label={`Chapter ${i + 1}: ${ch.year}`}>
              <div class="shape" aria-hidden="true" />
              <div class="tags">
                <span class="tag tag--dark">STEP {pad(i + 1)}</span>
                <span class="tag">{ch.role}</span>
              </div>
              <div class="year" aria-hidden="true">
                {ch.year}
              </div>
              <h3>{ch.title}</h3>
              <div class="paras">
                {ch.paras.map((p) => (
                  <p>{p}</p>
                ))}
              </div>
            </article>

            <div class="side">
              <div class="card list-card">
                <span class="mono">{ch.listLabel}</span>
                <ul>
                  {ch.items.map((it) => (
                    <li>
                      <span class="item-icon" style={`background: ${it.bg}`} aria-hidden="true">
                        {it.k}
                      </span>
                      <span class="item-text">
                        <span class="item-name">{it.name}</span>
                        <span class="item-sub">{it.sub}</span>
                      </span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="card line-card">
                <svg class="squiggle" viewBox="0 0 190 90" fill="none" aria-hidden="true">
                  <path d="M4 60 C 30 10, 50 10, 70 50 S 110 90, 130 40 S 170 0, 186 30" stroke="var(--orange)" stroke-width="10" stroke-linecap="round" />
                </svg>
                <span class="mono">IN ONE LINE</span>
                <p class="line">{ch.line}</p>
              </div>

              <button type="button" class="card next-card" data-go="next">
                <span class="mono">{next.label}</span>
                <span class="next-row">
                  <span class="next-year">{next.year}</span>
                  <span class="round round--dark" aria-hidden="true">
                    <Icon name="arrow-right" />
                  </span>
                </span>
              </button>
            </div>

            <div class="mobile-nav">
              <button type="button" class="prev-round" data-go="prev" aria-label="Previous chapter">
                <Icon name="arrow-left" size={18} />
              </button>
              <button type="button" class="next-wide" data-go="next">
                <span class="next-wide-text">
                  <span class="mono">{next.label}</span>
                  <span class="next-wide-year">{next.year}</span>
                </span>
                <span class="round round--dark" aria-hidden="true">
                  <Icon name="arrow-right" />
                </span>
              </button>
            </div>
          </div>
        );
      })
    }
  </div>

  <div class="bottom-bar">
    <button type="button" class="bar-btn" data-go="prev"><Icon name="arrow-left" /> Previous chapter</button>
    <div class="dots" aria-hidden="true">
      {journey.map((_, i) => <span class:list={['dot', { 'is-on': i === startChapter }]} data-dot />)}
    </div>
    <button type="button" class="bar-btn bar-btn--dark" data-go="next">Next chapter <Icon name="arrow-right" /></button>
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('#journey');
    if (!root) return;

    const total = Number(root.dataset.total);
    const chapters = [...root.querySelectorAll<HTMLElement>('[data-chapter]')];
    const yearButtons = [...root.querySelectorAll<HTMLButtonElement>('.years [data-go]')];
    const dots = [...root.querySelectorAll<HTMLElement>('[data-dot]')];
    const stepLabel = root.querySelector('[data-step-label]')!;
    const pctLabel = root.querySelector('[data-pct-label]')!;
    const bar = root.querySelector<HTMLElement>('[data-bar]')!;
    const status = root.querySelector('[data-status]')!;
    const pad = (n: number) => String(n).padStart(2, '0');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let current = Number(root.dataset.start);

    function show(index: number, from?: HTMLElement) {
      if (index === current) return;
      current = index;
      const pct = `${Math.round(((index + 1) / total) * 100)}%`;

      chapters.forEach((ch, i) => (ch.hidden = i !== index));
      yearButtons.forEach((b, i) => b.setAttribute('aria-pressed', String(i === index)));
      dots.forEach((d, i) => d.classList.toggle('is-on', i === index));
      stepLabel.textContent = `CHAPTER ${pad(index + 1)} OF ${pad(total)}`;
      pctLabel.textContent = pct;
      bar.style.width = pct;
      status.textContent = `Chapter ${index + 1} of ${total}: ${yearButtons[index].textContent?.trim()}`;

      const chapter = chapters[index];
      if (!reduced) {
        gsap.fromTo(
          chapter.querySelectorAll('.story, .card'),
          { autoAlpha: 0, y: 24 },
          { autoAlpha: 1, y: 0, duration: 0.5, stagger: 0.06, ease: 'power3.out', clearProps: 'transform,opacity,visibility' },
        );
      }

      // The clicked button may have just been hidden with its old chapter:
      // move focus to the matching visible button in the new one.
      if (from && from.closest('[data-chapter]')) {
        const match = [...chapter.querySelectorAll<HTMLElement>(`[data-go="${from.dataset.go}"]`)].find(
          (b) => b.offsetParent !== null,
        );
        match?.focus();
      }
    }

    root.querySelectorAll<HTMLButtonElement>('[data-go]').forEach((button) =>
      button.addEventListener('click', () => {
        const go = button.dataset.go!;
        const target = go === 'next' ? (current + 1) % total : go === 'prev' ? (current - 1 + total) % total : Number(go);
        show(target, button);
      }),
    );
  });
</script>

<style>
  .journey {
    padding: 48px var(--gutter) 0;
  }

  /* ---------- Header + stepper ---------- */
  .head {
    padding-bottom: 40px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
  }

  .title {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .pill {
    align-self: flex-start;
    padding: 7px 14px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line);
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 88px;
    line-height: 0.9;
    letter-spacing: -0.055em;
  }

  .stepper {
    width: 520px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .progress-label {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }

  .bar {
    height: 8px;
    overflow: hidden;
    border-radius: var(--radius-pill);
    background: var(--line);
  }

  .bar-fill {
    height: 100%;
    border-radius: var(--radius-pill);
    background: var(--orange);
    transition: width 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .years {
    display: flex;
    gap: 8px;
  }

  .years button {
    flex-grow: 1;
    height: 48px;
    padding: 0;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--text);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: -0.02em;
    transition:
      background-color 0.2s,
      color 0.2s,
      border-color 0.2s;
  }

  .years button:hover {
    border-color: var(--text);
  }

  .years button[aria-pressed='true'] {
    border-color: var(--dark);
    background: var(--dark);
    color: var(--on-dark);
  }

  /* ---------- Chapter ---------- */
  .chapters {
    padding: 16px 0 32px;
  }

  .chapter {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 16px;
  }

  .chapter[hidden] {
    display: none;
  }

  .story {
    grid-column: 1 / span 8;
    position: relative;
    overflow: hidden;
    min-height: 620px;
    padding: 48px 52px;
    display: flex;
    flex-direction: column;
    gap: 28px;
    border-radius: 36px;
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .shape {
    position: absolute;
    right: -90px;
    top: -90px;
    width: 280px;
    height: 280px;
    border-radius: 50%;
    background: var(--shape);
  }

  .tags {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag {
    padding: 7px 14px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line);
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .tag--dark {
    border-color: var(--dark);
    background: var(--dark);
    color: var(--on-dark);
  }

  /* Outline year. Stroke painted under a surface-coloured fill hides the
     variable font's overlapping contours (same trick as the footer). */
  .year {
    position: relative;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 188px;
    line-height: 0.82;
    letter-spacing: -0.06em;
    color: var(--surface);
    -webkit-text-stroke: 6px var(--orange);
    paint-order: stroke fill;
  }

  h3 {
    position: relative;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 44px;
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  .paras {
    position: relative;
    max-width: 700px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .paras p {
    font-size: 18px;
    line-height: 1.6;
    color: #3f3d39;
  }

  /* ---------- Side cards ---------- */
  .side {
    grid-column: 9 / span 4;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .card {
    position: relative;
    overflow: hidden;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    border-radius: 32px;
  }

  .mono {
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .list-card {
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .list-card .mono {
    color: var(--muted);
  }

  .list-card ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .list-card li {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .item-icon {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    color: var(--dark);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 15px;
  }

  .item-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .item-name {
    font-weight: 600;
    font-size: 16px;
  }

  .item-sub {
    font-size: 13px;
    color: var(--muted);
  }

  .line-card {
    gap: 14px;
    background: var(--sky);
    color: var(--dark);
  }

  .squiggle {
    position: absolute;
    right: -10px;
    top: 16px;
    width: 150px;
    height: 70px;
  }

  .line {
    position: relative;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 24px;
    line-height: 1.15;
    letter-spacing: -0.035em;
  }

  .next-card {
    flex-grow: 1;
    min-height: 150px;
    justify-content: space-between;
    align-items: flex-start;
    border: 0;
    background: var(--orange);
    color: var(--dark);
    text-align: left;
  }

  .next-row {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .next-year {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 34px;
    letter-spacing: -0.045em;
  }

  .round {
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: transform 0.25s;
  }

  .round--dark {
    background: var(--dark);
    color: var(--on-dark);
  }

  .next-card:hover .round,
  .next-wide:hover .round {
    transform: translateX(4px);
  }

  /* Mobile/tablet prev + next row */
  .mobile-nav {
    display: none;
  }

  /* ---------- Bottom bar (desktop) ---------- */
  .bottom-bar {
    padding-bottom: 72px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .bar-btn {
    height: 52px;
    padding: 0 22px;
    display: flex;
    align-items: center;
    gap: 10px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line);
    background: var(--surface);
    font-weight: 500;
    font-size: 15px;
  }

  .bar-btn--dark {
    border-color: var(--dark);
    background: var(--dark);
    color: var(--on-dark);
    font-weight: 600;
  }

  .dots {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: var(--radius-pill);
    background: var(--line);
    transition:
      width 0.3s,
      background-color 0.3s;
  }

  .dot.is-on {
    width: 28px;
    background: var(--orange);
  }

  /* ========== Tablet ========== */
  @media (max-width: 1023px) {
    .head {
      flex-direction: column;
      align-items: stretch;
      gap: 24px;
      padding-bottom: 24px;
    }

    h2 {
      font-size: 64px;
    }

    .stepper {
      width: auto;
    }

    .chapter {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .story {
      grid-column: 1 / -1;
      min-height: 0;
      padding: 40px;
      gap: 24px;
    }

    .year {
      font-size: 140px;
    }

    h3 {
      font-size: 36px;
    }

    .side {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .next-card,
    .bottom-bar {
      display: none;
    }

    .mobile-nav {
      grid-column: 1 / -1;
      display: flex;
      gap: 10px;
    }

    .journey {
      padding-bottom: 40px;
    }

    .chapters {
      padding-bottom: 0;
    }

    .prev-round {
      width: 64px;
      height: 64px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      border: 1px solid var(--line);
      background: var(--surface);
    }

    .next-wide {
      flex-grow: 1;
      height: 64px;
      padding: 0 8px 0 22px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border: 0;
      border-radius: var(--radius-pill);
      background: var(--orange);
      color: var(--dark);
      text-align: left;
    }

    .next-wide-text {
      display: flex;
      flex-direction: column;
    }

    .next-wide .mono {
      font-size: 10px;
    }

    .next-wide-year {
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 18px;
      letter-spacing: -0.03em;
    }

    .next-wide .round {
      width: 48px;
      height: 48px;
    }
  }

  /* ========== Mobile ========== */
  @media (max-width: 640px) {
    .hide-mobile {
      display: none;
    }

    .journey {
      padding: 24px var(--gutter) 20px;
    }

    .head {
      gap: 18px;
      padding-bottom: 20px;
    }

    .title {
      gap: 18px;
    }

    .pill {
      padding: 6px 12px;
      font-size: 11px;
    }

    h2 {
      font-size: 44px;
      line-height: 0.92;
    }

    .stepper {
      gap: 10px;
    }

    .progress-label {
      font-size: 11px;
    }

    .bar {
      height: 6px;
    }

    .years {
      gap: 6px;
    }

    .years button {
      height: var(--tap);
      font-size: 12px;
    }

    .chapters {
      padding-top: 4px;
    }

    .chapter {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }

    .story {
      padding: 26px 22px;
      gap: 18px;
      border-radius: 30px;
    }

    .shape {
      right: -70px;
      top: -70px;
      width: 190px;
      height: 190px;
    }

    .tags {
      gap: 6px;
    }

    .tag {
      padding: 6px 10px;
      font-size: 10px;
    }

    .year {
      font-size: 96px;
      line-height: 0.84;
      -webkit-text-stroke-width: 4px;
    }

    h3 {
      font-size: 28px;
      line-height: 1.06;
    }

    .paras {
      gap: 12px;
    }

    .paras p {
      font-size: 16px;
    }

    .side {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }

    .card {
      padding: 22px;
      gap: 14px;
      border-radius: 28px;
    }

    .mono {
      font-size: 11px;
    }

    .list-card ul {
      gap: 14px;
    }

    .list-card li {
      gap: 12px;
    }

    .item-icon {
      width: 44px;
      height: 44px;
      border-radius: 13px;
      font-size: 13px;
    }

    .item-name {
      font-size: 15px;
    }

    .item-sub {
      font-size: 12px;
    }

    .line-card {
      gap: 10px;
    }

    .squiggle {
      width: 120px;
      height: 56px;
    }

    .line {
      font-size: 20px;
      line-height: 1.18;
      letter-spacing: -0.03em;
    }
  }
</style>
