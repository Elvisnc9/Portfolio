---
import { services } from '../../data/about';
---

<section class="services" aria-label="What I do">
  {
    services.map((s, i) => (
      <div class="service" data-reveal data-reveal-delay={String(i * 0.06)}>
        <span class="num" aria-hidden="true">{s.n}</span>
        <div class="text">
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </div>
      </div>
    ))
  }
</section>

<style>
  .services {
    padding: 16px var(--gutter) 56px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .service {
    height: 260px;
    padding: 26px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-radius: 30px;
    background: var(--surface);
    border: 1px solid var(--line);
    transition: transform 0.25s;
  }

  .service:hover {
    transform: translateY(-4px);
  }

  /* Big outlined number, same treatment as the journey years: the stroke is
     painted under a surface-coloured fill to hide the variable font overlaps */
  .num {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 88px;
    line-height: 0.82;
    letter-spacing: -0.06em;
    color: var(--surface);
    -webkit-text-stroke: 5px var(--orange);
    paint-order: stroke fill;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: -0.035em;
  }

  p {
    font-size: 15px;
    line-height: 1.5;
    color: var(--muted);
  }

  @media (max-width: 1023px) {
    .services {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .service {
      height: 240px;
    }
  }

  @media (max-width: 640px) {
    .services {
      padding: 0 var(--gutter) 40px;
      gap: 10px;
    }

    .service {
      height: 200px;
      padding: 18px;
      border-radius: 24px;
    }

    .num {
      font-size: 56px;
      -webkit-text-stroke-width: 4px;
    }

    .text {
      gap: 4px;
    }

    h3 {
      font-size: 16px;
      letter-spacing: -0.03em;
    }

    p {
      font-size: 13px;
      line-height: 1.45;
    }
  }
</style>
