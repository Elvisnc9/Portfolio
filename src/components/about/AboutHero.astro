---
import Icon from '../Icon.astro';
import { site, cvUrl } from '../../data/site';
import { aboutIntro } from '../../data/about';
import { stats } from '../../data/home';
---

<section class="about-hero">
  <div class="stage" data-lean>
    <div class="topline">
      <span class="pill">ABOUT ME</span>
      <span class="meta"><span class="hide-mobile">SOFTWARE DEVELOPER · </span>EST. {stats.years.since} · NIGERIA</span>
    </div>

    <div class="circle" aria-hidden="true" data-speed="0.7"></div>
    <img
      class="portrait"
      data-speed="0.9"
      src="/images/portrait.webp"
      alt={`Portrait of ${site.owner}`}
      width="760"
      height="760"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />

    <span class="chip chip--hi" data-speed="1.4">Hi, I'm Elvis</span>
    <span class="chip chip--stack" data-speed="1.25">Flutter · Serverpod · AI</span>

    <h1 class="name" data-speed="1.1">ELVIS <br class="name-break" />NGWU</h1>
  </div>

  <div class="intro" data-reveal>
    <p>{aboutIntro}</p>
    <div class="buttons">
      <a class="btn btn--dark" href="/contact">Work with me <Icon name="arrow-right" size={18} /></a>
      <a class="btn btn--light" href={cvUrl} download><span><span class="hide-mobile">Download </span>CV</span></a>
    </div>
  </div>
</section>

<style>
  .about-hero {
    padding: 24px var(--gutter);
  }

  /* ---------- Portrait stage ---------- */
  .stage {
    position: relative;
    container-type: inline-size;
    height: 800px;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  .topline {
    position: absolute;
    left: 0;
    right: 0;
    top: 16px;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .pill {
    padding: 7px 14px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .meta {
    color: var(--muted);
  }

  .circle {
    position: absolute;
    left: 50%;
    top: 70px;
    width: 580px;
    height: 580px;
    translate: -50% 0;
    border-radius: 50%;
    background: var(--orange);
  }

  .portrait {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 700px;
    height: 700px;
    translate: -50% 0;
    object-fit: contain;
    object-position: bottom;
    filter: grayscale(1) contrast(1.08);
  }

  .chip {
    position: absolute;
    z-index: 2;
    padding: 11px 18px;
    border-radius: var(--radius-pill);
    font-weight: 600;
    font-size: 15px;
    white-space: nowrap;
  }

  .chip--hi {
    left: 120px;
    top: 250px;
    background: var(--dark);
    color: var(--on-dark);
    rotate: -8deg;
  }

  .chip--stack {
    right: 110px;
    top: 330px;
    background: var(--sky);
    color: var(--dark);
    rotate: 7deg;
  }

  /* Sized from the stage width (cqi) so it always fits edge to edge: 176px at 1440 */
  .name {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 22px;
    z-index: 1;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: min(13cqi, 176px);
    line-height: 0.82;
    letter-spacing: var(--tracking-tight);
    white-space: nowrap;
    color: var(--orange);
  }

  .name-break {
    display: none;
  }

  /* ---------- Intro row ---------- */
  .intro {
    padding-top: 32px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 40px;
  }

  .intro p {
    max-width: 820px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 28px;
    line-height: 1.3;
    letter-spacing: -0.025em;
  }

  .buttons {
    flex-shrink: 0;
    display: flex;
    gap: 10px;
  }

  .btn {
    height: 56px;
    padding: 0 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border-radius: var(--radius-pill);
    font-size: 16px;
    transition: transform 0.2s;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .btn--dark {
    background: var(--dark);
    color: var(--on-dark);
    font-weight: 600;
  }

  .btn--light {
    padding: 0 24px;
    border: 1px solid var(--line);
    background: var(--surface);
    font-weight: 500;
  }

  /* ========== Tablet (no mockup: scaled between desktop and mobile) ========== */
  @media (max-width: 1023px) {
    .stage {
      height: 660px;
    }

    .circle {
      top: 70px;
      width: 470px;
      height: 470px;
    }

    .portrait {
      width: 570px;
      height: 570px;
    }

    .chip {
      padding: 10px 16px;
      font-size: 14px;
    }

    .chip--hi {
      left: 24px;
      top: 200px;
    }

    .chip--stack {
      right: 16px;
      top: 290px;
    }

    .intro {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
    }

    .intro p {
      font-size: 24px;
    }
  }

  /* ========== Mobile ========== */
  @media (max-width: 640px) {
    .hide-mobile {
      display: none;
    }

    .about-hero {
      padding: 20px var(--gutter) 12px;
    }

    .stage {
      height: 540px;
    }

    .topline {
      top: 4px;
    }

    .pill {
      padding: 6px 12px;
      font-size: 11px;
    }

    .meta {
      font-size: 10px;
    }

    .circle {
      top: 60px;
      width: 320px;
      height: 320px;
    }

    .portrait {
      width: 420px;
      height: 420px;
    }

    .chip {
      padding: 8px 13px;
      font-size: 13px;
    }

    .chip--hi {
      left: 0;
      top: 130px;
    }

    .chip--stack {
      display: none;
    }

    /* 80px at 390 wide, two lines */
    .name {
      bottom: 14px;
      font-size: 22.3cqi;
      line-height: 0.84;
    }

    .name-break {
      display: inline;
    }

    .intro {
      padding-top: 20px;
      gap: 16px;
      align-items: stretch;
    }

    .intro p {
      font-size: 19px;
      line-height: 1.35;
      letter-spacing: -0.02em;
    }

    .buttons {
      gap: 8px;
    }

    .btn {
      height: 52px;
      gap: 8px;
      font-size: 15px;
    }

    .btn--dark {
      flex-grow: 1;
    }

    .btn--light {
      padding: 0 18px;
    }
  }
</style>
