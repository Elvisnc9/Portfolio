---
// Huge two-line title + round orange arrow linking to the full page.
// Desktop: label on the right. Tablet/mobile: label above, arrow pushed right.
import Icon from './Icon.astro';

interface Props {
  /** Two lines, e.g. ['About', 'me'] */
  title: [string, string];
  href: string;
  label: string;
  /** Shorter label for tablet/mobile */
  labelCompact?: string;
}

const { title, href, label, labelCompact } = Astro.props;
---

<div class="section-head" data-reveal>
  <span class="label">
    {
      labelCompact ? (
        <>
          <span class="full">{label}</span>
          <span class="compact">{labelCompact}</span>
        </>
      ) : (
        label
      )
    }
  </span>

  <a class="link" href={href} aria-label={`${title.join(' ')}, open page`}>
    <h2>{title[0]}<br />{title[1]}</h2>
    <span class="arrow" aria-hidden="true"><Icon name="arrow-up-right" size={38} /></span>
  </a>
</div>

<style>
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
  }

  .label {
    order: 1;
    padding-bottom: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }

  .compact {
    display: none;
  }

  .link {
    display: flex;
    align-items: flex-end;
    gap: 24px;
  }

  h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 96px;
    line-height: 0.92;
    letter-spacing: var(--tracking-tight);
  }

  .arrow {
    width: 96px;
    height: 96px;
    flex-shrink: 0;
    margin-bottom: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--orange);
    color: var(--dark);
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .link:hover .arrow {
    transform: rotate(45deg) scale(1.05);
  }

  @media (max-width: 1023px) {
    .section-head {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
    }

    .label {
      order: 0;
      padding-bottom: 0;
      font-size: 11px;
    }

    .full {
      display: none;
    }

    .compact {
      display: inline;
    }

    .link {
      justify-content: space-between;
      gap: 16px;
    }

    h2 {
      font-size: 72px;
      line-height: 0.93;
    }

    .arrow {
      width: 84px;
      height: 84px;
      margin-bottom: 4px;
    }

    .arrow :global(svg) {
      width: 32px;
      height: 32px;
    }
  }

  @media (max-width: 640px) {
    h2 {
      font-size: 50px;
    }

    .arrow {
      width: 64px;
      height: 64px;
    }

    .arrow :global(svg) {
      width: 24px;
      height: 24px;
    }
  }
</style>
