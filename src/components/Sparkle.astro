---
// 4-point star used as decoration.
interface Props {
  size?: number;
  color?: string;
  class?: string;
}

const { size = 24, color = 'currentColor', class: className } = Astro.props;
---

<svg class={className} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true">
  <path d="M12 0c.8 6.4 4.8 10.4 12 12-7.2 1.6-11.2 5.6-12 12-.8-6.4-4.8-10.4-12-12 7.2-1.6 11.2-5.6 12-12z" fill={color}></path>
</svg>
