---
import Icon from '../Icon.astro';
import FloatingToys from '../FloatingToys.astro';
import ProjectTile, { type TileLayout } from './ProjectTile.astro';
import { projects } from '../../data/projects';
import { experiments } from '../../data/home';

// Bento sizes per tile, straight from the mockups.
const layouts: Record<string, TileLayout> = {
  'genspark-ai': { desktop: [7, 560], tablet: [6, 460], mobile: 420, pills: 'top', arrow: 'orange', cursor: true, speed: 0.96 },
  articos: { desktop: [5, 560], tablet: [3, 340], mobile: 260, pills: 'bottom', arrow: 'light', speed: 1.05 },
  wealthfolio: { desktop: [5, 440], tablet: [3, 340], mobile: 300, pills: 'bottom', speed: 1.04 },
  kidemis: { desktop: [4, 440], tablet: [2, 300], mobile: 240, pills: 'bottom', speed: 0.96 },
  bitwyre: { desktop: [3, 440], tablet: [2, 300], mobile: 220, pills: 'bottom', stackPills: true, imageWidth: '86%', speed: 1.06 },
  'muslim-matrimony': { desktop: [4, 400], tablet: [2, 300], mobile: 360, pills: 'top', stackPills: true, speed: 1 },
};

interface Props {
  /** Standalone /work page: the title becomes the page h1 */
  page?: boolean;
}

const { page = false } = Astro.props;
const Heading = page ? 'h1' : 'h2';

const filters = ['All', 'Mobile', 'Web', 'AI'];
const count = String(projects.length).padStart(2, '0');
---

<section id={page ? undefined : 'work'} class:list={['work', { 'work--page': page }]}>
  <header class="head" data-lean>
    <FloatingToys
      toys={[
        { kind: 'star', pos: 'right: 32%; top: 0', size: 56, speed: 1.4 },
        { kind: 'star', pos: 'right: 4%; top: 0', size: 40, speed: 1.3, mobile: true },
        { kind: 'arch', pos: 'right: 20%; top: 30px', speed: 1.2, anim: 'bob3' },
        { kind: 'dot-dark', pos: 'right: 42%; top: 110px', size: 14, speed: 0.7, anim: 'bob4' },
      ]}
    />
    <div class="title-wrap" data-reveal>
      <Heading class="title">Selected<br />work</Heading>
      <span class="badge" data-speed="1.3" aria-label={`${projects.length} projects`}>{count}</span>
    </div>

    <div class="filters" role="group" aria-label="Filter projects" data-reveal data-reveal-delay="0.1">
      {
        filters.map((f, i) => (
          <button type="button" data-filter={f} aria-pressed={i === 0 ? 'true' : 'false'}>
            {f}
          </button>
        ))
      }
    </div>
  </header>

  {projects.map((project) => <ProjectTile project={project} layout={layouts[project.slug]} />)}

  <div class="experiments" data-reveal>
    <div class="exp-head">
      <h3>More experiments</h3>
      <span class="mono"><span class="hide-mobile">SIDE QUESTS · </span>{String(experiments.length).padStart(2, '0')}</span>
    </div>
    <ul class="exp-list">
      {
        experiments.map((p) => {
          const Tag = p.href ? 'a' : 'div';
          return (
            <li>
              <Tag
                class="exp-row"
                href={p.href}
                target={p.href?.startsWith('http') ? '_blank' : undefined}
                rel={p.href?.startsWith('http') ? 'noopener noreferrer' : undefined}
              >
                <span class="exp-icon" aria-hidden="true" data-float>
                  <Icon name={p.icon} size={34} stroke={2.6} />
                </span>
                <span class="exp-text">
                  <span class="exp-name">{p.name}</span>
                  <span class="exp-type">{p.type}</span>
                </span>
                {p.href && <Icon name="arrow-up-right" size={18} />}
              </Tag>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { Flip } from 'gsap/Flip';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(Flip, ScrollTrigger);

  document.addEventListener('astro:page-load', () => {
    const section = document.querySelector<HTMLElement>('.work');
    if (!section) return;

    const buttons = section.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const slots = [...section.querySelectorAll<HTMLElement>('.slot')];
    const extras = section.querySelector<HTMLElement>('.experiments');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    buttons.forEach((button) =>
      button.addEventListener('click', () => {
        const filter = button.dataset.filter!;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));

        // Remember where everything is, change the layout, then animate from the old spots
        const state = Flip.getState([...slots, extras].filter(Boolean) as HTMLElement[]);
        slots.forEach((slot) => {
          const match = filter === 'All' || slot.dataset.categories!.split(' ').includes(filter);
          slot.classList.toggle('is-out', !match);
        });
        extras?.classList.toggle('is-out', filter !== 'All');
        section.classList.toggle('is-filtered', filter !== 'All');

        if (reduced) return ScrollTrigger.refresh();
        Flip.from(state, {
          duration: 0.7,
          ease: 'power3.inOut',
          stagger: 0.04,
          absolute: true,
          onEnter: (els) => gsap.fromTo(els, { autoAlpha: 0, scale: 0.9 }, { autoAlpha: 1, scale: 1, duration: 0.5, delay: 0.2 }),
          onLeave: (els) => gsap.to(els, { autoAlpha: 0, scale: 0.9, duration: 0.3 }),
          onComplete: () => ScrollTrigger.refresh(),
        });
      }),
    );
  });
</script>

<style>
  .work {
    padding: 72px var(--gutter) 96px;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 16px;
    scroll-margin-top: 24px;
  }

  /* ---------- Header ---------- */
  .head {
    position: relative;
    isolation: isolate;
    grid-column: 1 / -1;
    margin-bottom: 32px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
  }

  /* Shrink-wraps the title so the badge can sit at the end of "Selected" */
  .title-wrap {
    position: relative;
    width: fit-content;
  }

  .title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 96px;
    line-height: 0.92;
    letter-spacing: var(--tracking-tight);
  }

  .badge {
    position: absolute;
    left: calc(100% - 20px);
    top: -30px;
    width: 84px;
    height: 84px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--sky);
    color: var(--dark);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    transform: rotate(-12deg);
  }

  .filters {
    display: flex;
    padding: 5px;
    border-radius: var(--radius-pill);
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .filters button {
    height: var(--tap);
    padding: 0 22px;
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--muted);
    font-weight: 500;
    font-size: 14px;
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .filters button:hover {
    color: var(--text);
  }

  .filters button[aria-pressed='true'] {
    background: var(--text);
    color: var(--bg);
    font-weight: 600;
  }

  /* ---------- Filtered ---------- */
  .work :global(.is-out) {
    display: none !important;
  }

  .work.is-filtered :global(.slot) {
    grid-column: span 6;
    height: 460px;
  }

  @media (max-width: 1023px) {
    .work.is-filtered :global(.slot) {
      grid-column: span 3;
      height: 340px;
    }
  }

  @media (max-width: 640px) {
    .work.is-filtered :global(.slot) {
      grid-column: 1 / -1;
      height: var(--h-m);
    }
  }

  /* ---------- More experiments ---------- */
  .experiments {
    grid-column: span 8;
    height: 400px;
    padding: 32px 36px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    border-radius: var(--radius-tile);
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .exp-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 30px;
    letter-spacing: -0.04em;
  }

  .mono {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }

  .exp-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 32px;
  }

  .exp-row {
    height: 84px;
    display: flex;
    align-items: center;
    gap: 16px;
    border-top: 1px solid var(--line);
  }

  /* Icon on its own, no tile: bigger, bolder, floating (see motion.ts) */
  .exp-icon {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text);
  }

  .exp-text {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .exp-name {
    font-weight: 600;
    font-size: 17px;
  }

  .exp-type {
    font-size: 13px;
    color: var(--muted);
  }

  /* ========== Tablet ========== */
  @media (max-width: 1023px) {
    .work {
      padding: 56px var(--gutter) 80px;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 14px;
    }

    .head {
      margin-bottom: 20px;
      flex-direction: column;
      align-items: flex-start;
      gap: 22px;
    }

    .title {
      font-size: 72px;
      line-height: 0.93;
    }

    .badge {
      left: calc(100% - 16px);
      top: -26px;
      width: 70px;
      height: 70px;
      font-size: 19px;
    }

    .experiments {
      grid-column: 1 / -1;
      height: auto;
      padding: 28px 28px 12px;
      gap: 14px;
      border-radius: 30px;
    }

    h3 {
      font-size: 26px;
    }

    .exp-list {
      column-gap: 24px;
    }

    .exp-row {
      height: 78px;
      gap: 14px;
    }

    .exp-name {
      font-size: 16px;
    }

    .exp-type {
      font-size: 12px;
    }
  }

  /* ========== Mobile ========== */
  @media (max-width: 640px) {
    .hide-mobile {
      display: none;
    }

    .work {
      padding: 48px var(--gutter) 64px;
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }

    .head {
      margin-bottom: 16px;
      align-items: stretch;
      gap: 20px;
    }

    .title {
      font-size: 50px;
      line-height: 0.95;
    }

    .badge {
      left: calc(100% - 12px);
      top: -22px;
      width: 58px;
      height: 58px;
      font-size: 16px;
    }

    .filters {
      padding: 4px;
    }

    .filters button {
      flex-grow: 1;
      padding: 0;
    }

    .experiments {
      padding: 22px 20px 8px;
      gap: 12px;
      border-radius: var(--radius-tile);
    }

    h3 {
      font-size: 22px;
    }

    .mono {
      font-size: 11px;
    }

    .exp-list {
      grid-template-columns: minmax(0, 1fr);
    }

    .exp-row {
      height: 72px;
    }

    .exp-icon {
      width: 44px;
      height: 44px;
    }
  }
</style>
