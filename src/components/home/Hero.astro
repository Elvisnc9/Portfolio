---
// Home hero: the name, plus floating "desktop toys".
// Each toy is two layers:
//   .toy  (outer) positions + tilts it and carries data-speed for GSAP scroll parallax
//   .anim (inner) runs the CSS bob/spin loop
// so a GSAP transform on the outer layer never fights the CSS animation.
// Tilt uses the CSS `rotate` property (not transform) for the same reason.
// Positions come from Main/Tablet/Mobile.dc.html; x values are % of the width.
import Sparkle from '../Sparkle.astro';
import { site } from '../../data/site';
import { stats } from '../../data/home';
---

<section class="hero" aria-labelledby="hero-name">
  <h1 id="hero-name" class="name-block" data-speed="0.8">
    <span class="name">Elvis</span>
    <span class="visually-hidden">Ngwu,</span>
    <span class="role">SOFTWARE DEVELOPER<span class="caret" aria-hidden="true"></span></span>
  </h1>

  <div class="toys" aria-hidden="true">
    <div class="toy toy--star" data-speed="1.4">
      <div class="anim spin"><Sparkle size={170} color="var(--orange)" /></div>
    </div>

    <div class="toy toy--star-dark" data-speed="0.7">
      <div class="anim spin-r"><Sparkle size={44} color="var(--dark)" /></div>
    </div>

    <div class="toy toy--available" data-speed="1.2">
      <div class="anim bob">
        <span class="available">
          {site.available ? 'Available' : 'Booked'}
          <span class:list={['toggle', { 'is-on': site.available }]}><span></span></span>
        </span>
      </div>
    </div>

    <div class="toy toy--code" data-speed="0.8">
      <div class="anim bob2"><span class="code">&lt;/&gt;</span></div>
    </div>

    <div class="toy toy--e" data-speed="1.6">
      <div class="anim bob3"><span class="e">e.</span></div>
    </div>

    <div class="toy toy--cursor" data-speed="0.9">
      <div class="anim bob">
        <span class="cursor">
          <svg width="30" height="30" viewBox="0 0 24 24">
            <path d="M3 2l18 8-8 2.5L10 21z" fill="#111110" stroke="#FFFFFF" stroke-width="1.5" stroke-linejoin="round"></path>
          </svg>
          <span class="cursor-label">you’re here</span>
        </span>
      </div>
    </div>

    <div class="toy toy--clock" data-speed="1.1">
      <div class="anim bob4">
        <span class="clock"><span class="clock-dot"></span><time data-hero-clock>--:--</time> · NG</span>
      </div>
    </div>

    <div class="toy toy--circle" data-speed="0.6">
      <div class="anim bob2"><span class="circle"></span></div>
    </div>

    <div class="toy toy--arch" data-speed="1.3">
      <div class="anim bob3"><span class="arch"></span></div>
    </div>

    <div class="toy toy--dot-dark" data-speed="0.5">
      <div class="anim bob4"><span class="dot dot--dark"></span></div>
    </div>

    <div class="toy toy--dot-orange" data-speed="1.8">
      <div class="anim bob3"><span class="dot dot--orange"></span></div>
    </div>
  </div>

  <div class="bottom">
    <span>EST. {stats.years.since}</span>
    <a class="scroll" href="#work" aria-label="Scroll to selected work">
      SCROLL
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 5v14M6 13l6 6 6-6"></path>
      </svg>
    </a>
    <span>MOBILE · WEB · AI</span>
  </div>
</section>

<script>
  import { lagosTime } from '../../scripts/time';

  let timer: number | undefined;

  document.addEventListener('astro:page-load', () => {
    const clock = document.querySelector<HTMLElement>('[data-hero-clock]');
    if (!clock) return;
    const tick = () => (clock.textContent = lagosTime());
    tick();
    timer = window.setInterval(tick, 15_000);
  });

  document.addEventListener('astro:before-swap', () => window.clearInterval(timer));
</script>

<style>
  /* ---------- Stage ---------- */
  .hero {
    position: relative;
    height: 800px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .name-block {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 34px;
  }

  /* 330px at 1440 wide */
  .name {
    font-family: var(--font-name);
    font-weight: 800;
    font-size: min(22.9vw, 330px);
    line-height: 0.82;
    letter-spacing: -0.045em;
  }

  .role {
    display: flex;
    align-items: center;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 20px;
    letter-spacing: 0.32em;
  }

  .caret {
    display: inline-block;
    width: 12px;
    height: 22px;
    margin-left: 6px;
    background: var(--orange);
    animation: blink 1s steps(1) infinite;
  }

  /* ---------- Toys ---------- */
  .toy {
    position: absolute;
    z-index: 2;
  }

  .toy :global(svg) {
    display: block;
  }

  .available {
    padding: 8px 8px 8px 16px;
    display: flex;
    align-items: center;
    gap: 10px;
    border-radius: var(--radius-pill);
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: 0 14px 30px rgba(17, 17, 16, 0.1);
    font-size: 15px;
    font-weight: 600;
    white-space: nowrap;
  }

  .toggle {
    width: 50px;
    height: 28px;
    padding: 3px;
    display: flex;
    border-radius: var(--radius-pill);
    background: var(--line);
  }

  .toggle.is-on {
    justify-content: flex-end;
    background: var(--success);
  }

  .toggle span {
    aspect-ratio: 1;
    height: 100%;
    border-radius: 50%;
    background: var(--surface);
  }

  .code {
    width: 74px;
    height: 74px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 22px;
    background: var(--sky);
    color: var(--dark);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 20px;
  }

  .e {
    width: 96px;
    height: 96px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 25px;
    background: var(--orange);
    box-shadow: 0 18px 34px rgba(255, 106, 61, 0.35);
    color: var(--dark);
    font-family: var(--font-name);
    font-weight: 800;
    font-size: 40px;
  }

  .cursor {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }

  .cursor-label {
    margin-left: 21px;
    padding: 5px 11px;
    border-radius: 999px 999px 999px 4px;
    background: var(--dark);
    color: var(--on-dark);
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
  }

  .clock {
    padding: 8px 14px;
    display: flex;
    align-items: center;
    gap: 8px;
    border-radius: var(--radius-pill);
    background: var(--dark);
    color: var(--on-dark);
    font-family: var(--font-mono);
    font-size: 13px;
    white-space: nowrap;
  }

  .clock-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--orange);
  }

  .circle {
    display: block;
    width: 150px;
    height: 150px;
    border-radius: 50%;
    background: var(--sky);
  }

  .arch {
    display: block;
    width: 90px;
    height: 45px;
    border: 14px solid var(--orange);
    border-bottom: 0;
    border-radius: 90px 90px 0 0;
  }

  .dot {
    display: block;
    border-radius: 50%;
  }

  .dot--dark {
    width: 18px;
    height: 18px;
    background: var(--dark);
  }

  .dot--orange {
    width: 14px;
    height: 14px;
    background: var(--orange);
  }

  /* Desktop positions (1440 × 800) */
  .toy--star { left: 10.42%; top: 90px; }
  .toy--star-dark { right: 26.39%; top: 110px; }
  .toy--available { right: 9.03%; top: 200px; rotate: 6deg; }
  .toy--code { left: 27.78%; top: 140px; rotate: -8deg; }
  .toy--e { left: 8.33%; bottom: 170px; rotate: -12deg; }
  .toy--cursor { right: 18.06%; bottom: 190px; }
  .toy--clock { left: 25%; bottom: 110px; rotate: -4deg; }
  .toy--circle { right: -3.47%; bottom: 50px; }
  .toy--arch { right: 36.11%; bottom: 90px; }
  .toy--dot-dark { left: 4.17%; top: 380px; }
  .toy--dot-orange { right: 6.25%; top: 120px; }

  /* ---------- Bottom bar ---------- */
  .bottom {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 24px;
    z-index: 3;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }

  .scroll {
    min-height: var(--tap);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    color: var(--text);
    animation: nudge 1.8s ease-in-out infinite;
  }

  /* ---------- Loops (from the mockups) ---------- */
  .bob { animation: bob 3.4s ease-in-out infinite; }
  .bob2 { animation: bob 4.1s ease-in-out 0.7s infinite; }
  .bob3 { animation: bob 3.7s ease-in-out 1.3s infinite; }
  .bob4 { animation: bob 5s ease-in-out 0.3s infinite; }
  .spin { animation: spin 18s linear infinite; }
  .spin-r { animation: spin 26s linear infinite reverse; }

  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-18px); }
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  @keyframes nudge {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(8px); }
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .anim,
    .scroll,
    .caret {
      animation: none;
    }
  }

  /* ========== Tablet (834 × 720) ========== */
  @media (max-width: 1023px) {
    .hero {
      height: 720px;
    }

    .name-block {
      gap: 26px;
    }

    /* 220px at 834 wide */
    .name {
      font-size: 26.4vw;
    }

    .role {
      font-size: 15px;
      letter-spacing: 0.28em;
    }

    .caret {
      width: 9px;
      height: 16px;
    }

    .toy--star :global(svg) { width: 120px; height: 120px; }
    .toy--star-dark :global(svg) { width: 34px; height: 34px; }

    .available { font-size: 13px; }
    .toggle { width: 44px; height: 24px; }

    .code { width: 60px; height: 60px; border-radius: 18px; font-size: 17px; }
    .e { width: 78px; height: 78px; border-radius: 21px; font-size: 32px; }
    .cursor :global(svg) { width: 26px; height: 26px; }
    .cursor-label { margin-left: 18px; font-size: 12px; }
    .clock { font-size: 12px; }
    .circle { width: 110px; height: 110px; }

    .toy--star { left: 6%; top: 70px; }
    .toy--star-dark { right: 29.98%; top: 90px; }
    .toy--available { right: 7.19%; top: 120px; }
    .toy--code { left: 29.98%; top: 110px; }
    .toy--e { left: 7.19%; bottom: 150px; }
    .toy--cursor { right: 13.19%; bottom: 170px; }
    .toy--clock { left: 31.18%; bottom: 90px; }
    .toy--circle { right: -4.8%; bottom: 40px; }

    .toy--arch,
    .toy--dot-dark,
    .toy--dot-orange {
      display: none;
    }

    .bottom {
      font-size: 11px;
    }
  }

  /* ========== Mobile (390 × 640) ========== */
  @media (max-width: 640px) {
    .hero {
      height: 640px;
    }

    .name-block {
      gap: 18px;
    }

    /* The mockup's 128px clips real Syne at 390 wide (the word is ~3.35em wide),
       so size it to fill ~92% of the screen instead (~107px at 390) */
    .name {
      font-size: 27.5vw;
    }

    .role {
      font-size: 11px;
      letter-spacing: 0.24em;
    }

    .caret {
      width: 6px;
      height: 12px;
    }

    .toy--star :global(svg) { width: 84px; height: 84px; }
    .toy--star-dark :global(svg) { width: 26px; height: 26px; }

    .available { font-size: 12px; }
    .toggle { width: 38px; height: 22px; }

    .code { width: 48px; height: 48px; border-radius: 14px; font-size: 14px; }
    .e { width: 60px; height: 60px; border-radius: 16px; font-size: 26px; }
    .cursor :global(svg) { width: 22px; height: 22px; }
    .cursor-label { margin-left: 15px; font-size: 11px; }
    .circle { width: 90px; height: 90px; }

    .toy--star { left: 4.62%; top: 60px; }
    .toy--star-dark { right: 38.46%; top: 70px; }
    .toy--available { right: 4.1%; top: 120px; }
    .toy--e { left: 6.67%; bottom: 150px; }
    .toy--cursor { right: 10.26%; bottom: 170px; }
    .toy--code { left: 38.46%; top: auto; bottom: 90px; }
    .toy--circle { right: -9.23%; bottom: 60px; }

    .toy--clock {
      display: none;
    }

    .bottom {
      font-size: 10px;
    }
  }
</style>
