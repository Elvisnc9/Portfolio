---
import Icon from '../Icon.astro';
import SectionHead from '../SectionHead.astro';
import { site, socials, whatsapp } from '../../data/site';

const links = socials.filter((s) => s.href && !s.contactOnly);
---

<section id="contact" class="contact">
  <SectionHead title={['Contact', 'me']} href="/contact" label="REPLIES FROM NIGERIA · WAT" labelCompact="LET’S TALK" />

  <div class="panel" data-reveal>
    <div class="ring" aria-hidden="true" data-parallax="0.2"></div>

    <div class="main">
      <span class="pill">AVAILABLE FOR NEW PROJECTS</span>
      <h2>Got an idea? Let's build it.</h2>
      <p>
        <span class="hide-mobile">Freelance contracts, full-time roles and interesting collaborations. Tell me what you're building.</span>
        <span class="show-mobile">Freelance, full-time roles and interesting collaborations.</span>
      </p>
      <div class="reach">
        <a class="email" href={`mailto:${site.email}`}>{site.email}</a>
        <ul class="socials">
          {
            links.map((s) => (
              <li data-social={s.label}>
                <a href={s.href} target="_blank" rel="noopener noreferrer">
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Desktop: three doors -->
    <div class="doors">
      <span class="doors-label">PICK A DOOR</span>
      <a class="door door--primary" href="/contact">
        <span class="door-text">
          <span class="door-title">Start a project</span>
          <span class="door-sub">Tell me what you're building</span>
        </span>
        <span class="door-arrow"><Icon name="arrow-right" /></span>
      </a>
      <a class="door" href={`mailto:${site.email}`}>Send an email <Icon name="arrow-right" /></a>
      <a class="door" href={whatsapp} target="_blank" rel="noopener noreferrer">Chat on WhatsApp <Icon name="arrow-right" /></a>
    </div>

    <!-- Tablet + mobile: stacked buttons -->
    <div class="ctas">
      <a class="cta cta--start" href="/contact">
        Start a project
        <span class="cta-arrow"><Icon name="arrow-right" /></span>
      </a>
      <a class="cta cta--email" href={`mailto:${site.email}`}>Send an email <Icon name="arrow-right" /></a>
    </div>
  </div>
</section>

<style>
  .contact {
    padding: 32px var(--gutter) 72px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .panel {
    position: relative;
    overflow: hidden;
    padding: 64px;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 16px;
    border-radius: var(--radius-tile-lg);
    background: var(--orange);
    color: var(--dark);
  }

  .ring {
    position: absolute;
    left: -80px;
    bottom: -120px;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    border: 40px solid rgba(17, 17, 16, 0.1);
  }

  .show-mobile {
    display: none;
  }

  /* ---------- Left column ---------- */
  .main {
    grid-column: 1 / span 6;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .pill {
    align-self: flex-start;
    padding: 7px 14px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(17, 17, 16, 0.35);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 60px;
    line-height: 0.95;
    letter-spacing: -0.055em;
  }

  p {
    max-width: 460px;
    font-size: 18px;
    line-height: 1.55;
  }

  .reach {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .email {
    align-self: flex-start;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 26px;
    letter-spacing: -0.03em;
    text-decoration: underline;
    text-underline-offset: 7px;
    text-decoration-thickness: 2px;
    overflow-wrap: anywhere;
  }

  .email:hover {
    text-decoration-thickness: 4px;
  }

  .socials {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .socials a {
    min-height: var(--tap);
    padding: 0 18px;
    display: flex;
    align-items: center;
    border-radius: var(--radius-pill);
    background: var(--dark);
    color: var(--on-dark);
    font-size: 15px;
    transition: transform 0.2s;
  }

  .socials a:hover {
    transform: translateY(-2px);
  }

  /* ---------- Doors (desktop) ---------- */
  .doors {
    grid-column: 8 / span 5;
    position: relative;
    align-self: center;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    border-radius: 28px;
    background: var(--dark);
    color: var(--on-dark);
  }

  .doors-label {
    font-family: var(--font-mono);
    font-size: 12px;
    color: #a3a09a;
  }

  .door {
    height: 64px;
    padding: 0 20px 0 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-radius: 22px;
    border: 1px solid #2a2a2e;
    font-weight: 500;
    font-size: 16px;
    transition:
      background-color 0.2s,
      border-color 0.2s;
  }

  .door:hover {
    border-color: #4a4a50;
    background: #1c1c1e;
  }

  .door :global(svg) {
    transition: transform 0.2s;
  }

  .door:hover :global(svg) {
    transform: translateX(4px);
  }

  .door--primary {
    height: 76px;
    padding: 0 12px 0 24px;
    border: 0;
    background: var(--orange);
    color: var(--dark);
  }

  .door--primary:hover {
    background: #ff7d55;
  }

  .door-text {
    display: flex;
    flex-direction: column;
  }

  .door-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 19px;
    letter-spacing: -0.03em;
  }

  .door-sub {
    font-size: 13px;
    font-weight: 400;
  }

  .door-arrow,
  .cta-arrow {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--dark);
    color: var(--on-dark);
  }

  /* ---------- CTAs (tablet + mobile) ---------- */
  .ctas {
    display: none;
  }

  /* ========== Tablet ========== */
  @media (max-width: 1023px) {
    .contact {
      padding: 16px var(--gutter) 56px;
      gap: 32px;
    }

    .panel {
      padding: 40px;
      display: flex;
      flex-direction: column;
      gap: 24px;
      border-radius: 36px;
    }

    .ring {
      left: auto;
      right: -80px;
      top: -80px;
      bottom: auto;
      width: 260px;
      height: 260px;
      border-width: 34px;
    }

    .main {
      display: contents;
    }

    .pill,
    h2,
    .reach,
    .ctas {
      position: relative;
    }

    p {
      display: none;
    }

    .reach {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
    }

    .email {
      align-self: auto;
      font-size: 22px;
    }

    .socials {
      flex-wrap: nowrap;
      gap: 6px;
    }

    .socials a {
      padding: 0 14px;
      font-size: 14px;
    }

    .socials [data-social='X'],
    .socials [data-social='pub.dev'] {
      display: none;
    }

    .doors {
      display: none;
    }

    .ctas {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .cta {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .cta--start {
      height: 76px;
      padding: 0 12px 0 26px;
      border-radius: 24px;
      background: var(--dark);
      color: var(--on-dark);
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 19px;
      letter-spacing: -0.03em;
    }

    .cta-arrow {
      background: var(--orange);
      color: var(--dark);
    }

    .cta--email {
      display: none;
    }
  }

  /* ========== Mobile ========== */
  @media (max-width: 640px) {
    .hide-mobile {
      display: none;
    }

    .show-mobile {
      display: inline;
    }

    .contact {
      padding: 8px var(--gutter) 48px;
      gap: 24px;
    }

    .panel {
      padding: 26px 20px;
      gap: 22px;
      border-radius: 32px;
    }

    .ring {
      display: none;
    }

    .pill {
      padding: 6px 12px;
      font-size: 10px;
    }

    h2 {
      font-size: 38px;
      line-height: 0.98;
    }

    p {
      display: block;
      font-size: 16px;
    }

    /* Order: pill, title, text, email, buttons, socials */
    .reach {
      display: contents;
    }

    .email {
      align-self: flex-start;
      font-size: 17px;
      letter-spacing: -0.02em;
      text-underline-offset: 6px;
    }

    .ctas {
      order: 1;
    }

    .socials {
      order: 2;
      flex-wrap: wrap;
    }

    .socials [data-social='X'] {
      display: list-item;
    }

    .socials a {
      padding: 0 15px;
    }

    .cta--start {
      height: 68px;
      padding: 0 8px 0 20px;
      border-radius: 20px;
      font-size: 16px;
    }

    .cta-arrow {
      width: 50px;
      height: 50px;
    }

    .cta--email {
      display: flex;
      height: 54px;
      padding: 0 20px;
      border-radius: 20px;
      border: 1px solid rgba(17, 17, 16, 0.35);
      font-weight: 500;
      font-size: 15px;
    }
  }
</style>
