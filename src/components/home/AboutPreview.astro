---
import SectionHead from '../SectionHead.astro';
import { aboutChips, stats } from '../../data/home';

const tiles = [
  { eyebrow: 'SHIPPED', value: stats.shipped.value, caption: stats.shipped.label, tone: 'orange' },
  { eyebrow: 'TEAMWORK', value: stats.teamwork.value, caption: stats.teamwork.label, tone: 'sky' },
  { eyebrow: `SINCE ${stats.years.since}`, value: stats.years.value, caption: stats.years.label, tone: 'dark' },
];
---

<section id="about" class="about">
  <SectionHead title={['About', 'me']} href="/about" label="WHO’S BEHIND THIS" labelCompact="WHO’S BEHIND THIS" />

  <div class="body">
    <div class="intro" data-reveal>
      <p class="statement">I build apps and websites that feel as good as they <span>perform.</span></p>
      <ul class="chips">
        {aboutChips.map((chip) => <li>{chip}</li>)}
      </ul>
    </div>

    <div class="stats">
      {
        tiles.map((t, i) => (
          <div class={`stat stat--${t.tone}`} data-reveal data-reveal-delay={String(i * 0.08)}>
            <span class="stat-label">{t.eyebrow}</span>
            <div class="stat-body">
              <span class="stat-value">{t.value}</span>
              <span class="stat-caption">{t.caption}</span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .about {
    padding: 72px var(--gutter) 104px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .body {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 16px;
  }

  .intro {
    grid-column: 1 / span 7;
    padding-top: 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
    border-top: 1px solid var(--line);
  }

  .statement {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 40px;
    line-height: 1.12;
    letter-spacing: -0.04em;
  }

  .statement span {
    color: var(--orange);
  }

  .chips {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chips li {
    padding: 9px 15px;
    border-radius: var(--radius-pill);
    background: var(--surface);
    border: 1px solid var(--line);
    font-size: 14px;
    font-weight: 500;
  }

  .stats {
    grid-column: 8 / span 5;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .stat {
    height: 220px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-radius: 28px;
    color: var(--dark);
  }

  .stat--orange {
    background: var(--orange);
  }

  .stat--sky {
    background: var(--sky);
  }

  .stat--dark {
    background: var(--dark);
    color: var(--on-dark);
  }

  .stat--dark .stat-label {
    opacity: 0.7;
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .stat-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .stat-value {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 42px;
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .stat-caption {
    font-size: 13px;
    font-weight: 500;
  }

  @media (max-width: 1023px) {
    .about {
      padding: 56px var(--gutter) 72px;
      gap: 32px;
    }

    .body {
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    .intro {
      padding-top: 24px;
    }

    .statement {
      font-size: 34px;
      line-height: 1.14;
    }

    .chips {
      display: none;
    }

    .stats {
      gap: 10px;
    }

    .stat {
      height: 200px;
      padding: 22px;
      border-radius: 24px;
    }

    .stat-label {
      font-size: 10px;
    }
  }

  @media (max-width: 640px) {
    .about {
      padding: 48px var(--gutter) 64px;
      gap: 24px;
    }

    .body {
      gap: 24px;
    }

    .intro {
      padding-top: 20px;
      gap: 24px;
    }

    .statement {
      font-size: 24px;
      line-height: 1.18;
      letter-spacing: -0.035em;
    }

    .chips {
      display: flex;
      gap: 6px;
    }

    .chips li {
      padding: 8px 12px;
      font-size: 13px;
    }

    .chips li:nth-child(n + 3) {
      display: none;
    }

    .stat {
      height: 130px;
      padding: 14px;
    }

    .stat-value {
      font-size: 30px;
    }

    .stat-caption {
      font-size: 11px;
      line-height: 1.25;
    }
  }
</style>
