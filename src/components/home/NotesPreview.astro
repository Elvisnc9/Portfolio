---
import SectionHead from '../SectionHead.astro';
import { getNotes, noteNumber, noteUrl } from '../../lib/notes';

const notes = await getNotes();
const previews = notes.filter((note) => note.data.home).slice(0, 4);
const total = noteNumber(notes.length);
---

<section id="notes" class="notes">
  <div class="head">
    <SectionHead title={['Notes', 'to self']} href="/notes" label={`${total} NOTES · READ THEM ALL`} labelCompact={`${total} NOTES`} />
  </div>

  <ul class="board" aria-label="Latest notes">
    {
      previews.map((note, i) => (
        <li class="sticky" style={`--note-bg: ${note.data.color}; --rot: ${note.data.rotate}deg`} data-reveal data-reveal-delay={String(i * 0.08)}>
          <span class="tape" aria-hidden="true" />
          <span class="note-num">NOTE {noteNumber(note.data.n)}</span>
          <h3>
            <a href={noteUrl(note)}>{note.data.title}</a>
          </h3>
          <p>{note.data.excerptShort ?? note.data.excerpt}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .notes {
    padding: 64px var(--gutter) 104px;
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  .board {
    margin: 0;
    padding: 0 12px;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px;
  }

  .sticky {
    position: relative;
    height: 330px;
    padding: 34px 28px 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    border-radius: 6px;
    background: var(--note-bg);
    color: var(--dark);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.18);
    transform: rotate(var(--rot));
    transition:
      transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.35s;
  }

  .sticky:hover {
    transform: rotate(0deg) translateY(-6px);
    box-shadow: 0 26px 50px rgba(0, 0, 0, 0.2);
  }

  /* Stretched link: the title link covers the whole note */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .sticky:focus-within {
    outline: 2px solid var(--orange);
    outline-offset: 4px;
  }

  h3 a:focus-visible {
    outline: none;
  }

  .tape {
    position: absolute;
    left: 50%;
    top: -12px;
    width: 96px;
    height: 26px;
    margin-left: -48px;
    background: rgba(255, 255, 255, 0.55);
    transform: rotate(-3deg);
  }

  .note-num {
    font-family: var(--font-mono);
    font-size: 12px;
    opacity: 0.6;
  }

  h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 24px;
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  p {
    font-size: 15px;
    line-height: 1.55;
    color: #3f3d39;
  }

  /* ========== Tablet ========== */
  @media (max-width: 1023px) {
    .notes {
      padding: 24px var(--gutter) 80px;
      gap: 44px;
    }

    .board {
      padding: 0 10px;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .sticky {
      height: 280px;
      padding: 32px 26px 26px;
      gap: 12px;
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.18);
    }

    .tape {
      width: 92px;
      height: 24px;
      margin-left: -46px;
    }

    h3 {
      font-size: 22px;
      line-height: 1.1;
    }
  }

  /* ========== Mobile: swipe row ========== */
  @media (max-width: 640px) {
    .notes {
      padding: 24px 0 72px;
      gap: 32px;
    }

    .head {
      padding: 0 var(--gutter);
    }

    .board {
      padding: 14px 24px 24px;
      display: flex;
      gap: 18px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding: 0 24px;
      scrollbar-width: none;
    }

    .board::-webkit-scrollbar {
      display: none;
    }

    .sticky {
      width: 250px;
      height: 290px;
      flex-shrink: 0;
      padding: 30px 22px 22px;
      scroll-snap-align: start;
      box-shadow: 0 16px 34px rgba(0, 0, 0, 0.18);
    }

    .tape {
      top: -11px;
      width: 84px;
      height: 22px;
      margin-left: -42px;
    }

    .note-num {
      font-size: 11px;
    }

    h3 {
      font-size: 20px;
    }

    p {
      font-size: 14px;
    }
  }
</style>
