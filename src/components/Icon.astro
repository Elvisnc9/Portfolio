---
// Stroke icons used across the site (24px grid, inherits currentColor).
const paths = {
  'arrow-up-right': 'M7 17L17 7M8 7h9v9',
  'arrow-up': 'M12 19V5M6 11l6-6 6 6',
  'arrow-right': 'M5 12h14M13 6l6 6-6 6',
  'arrow-left': 'M19 12H5M11 18l-6-6 6-6',
  menu: 'M4 8h16M4 16h16',
  search: 'M11 18a7 7 0 1 1 0-14 7 7 0 0 1 0 14zM21 21l-4.35-4.35',
  // Project type icons ("More experiments")
  mail: 'M4 6h16v12H4zM4 7l8 6 8-6',
  video: 'M3 7h12v10H3zM15 11l6-4v10l-6-4',
  campus: 'M2 9l10-5 10 5-10 5-10-5zM6 11v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5M22 9v6',
  waveform: 'M4 10v4M8 7v10M12 4v16M16 8v8M20 11v2',
  ar: 'M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3zM12 12l8-4.5M12 12v9M12 12L4 7.5',
  layout: 'M3 5h18v14H3zM3 9h18M9 9v10',
  close: 'M6 6l12 12M18 6L6 18',
} as const;

interface Props {
  name: keyof typeof paths;
  size?: number;
}

const { name, size = 16 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={paths[name]}></path>
</svg>
