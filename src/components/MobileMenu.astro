---
import Icon from './Icon.astro';
import { navLinks, site, socials, type NavLabel } from '../data/site';

interface Props {
  active?: NavLabel;
}

const { active } = Astro.props;
---

<dialog id="mobile-menu" class="menu" aria-label="Menu">
  <div class="deco deco--circle" aria-hidden="true"></div>
  <div class="deco deco--arch" aria-hidden="true"></div>

  <div class="bar">
    <a class="brand" href="/">ELVES<span>·</span>CORPS</a>
    <button class="close-btn" type="button" aria-label="Close menu" data-menu-close>
      <Icon name="close" size={18} />
    </button>
  </div>

  <nav class="list" aria-label="Menu">
    {
      navLinks.map((link, i) => (
        <a href={link.href} data-nav-section={link.section} aria-current={link.label === active ? 'page' : undefined}>
          <span class="label">
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <span class="word">{link.label}</span>
          </span>
          <span class="arrow">
            <Icon name="arrow-up-right" size={18} />
          </span>
        </a>
      ))
    }
  </nav>

  <div class="bottom">
    <div class="status">
      <div class="status-text">
        <span class="mono">NG · WAT <time data-menu-clock>--:--</time></span>
        <span class="status-title">{site.available ? 'Available for work' : 'Booked for now'}</span>
      </div>
      <span class={`toggle ${site.available ? 'is-on' : ''}`} aria-hidden="true"><span></span></span>
    </div>

    <div class="socials">
      {
        socials
          .filter((s) => s.href && s.menu)
          .map((s) => (
            <a href={s.href} target="_blank" rel="noopener noreferrer">
              {s.label}
            </a>
          ))
      }
    </div>
  </div>

  <div class="menu-grain" aria-hidden="true"></div>
</dialog>

<script>
  import { lagosTime } from '../scripts/time';

  function setupMenu() {
    const menu = document.querySelector<HTMLDialogElement>('#mobile-menu');
    if (!menu) return;

    const clock = menu.querySelector<HTMLTimeElement>('[data-menu-clock]');
    let clockTimer: number | undefined;

    const tick = () => {
      if (!clock) return;
      clock.textContent = lagosTime();
    };

    const open = () => {
      tick();
      clockTimer = window.setInterval(tick, 30_000);
      menu.showModal();
      document.dispatchEvent(new CustomEvent('menu:toggle', { detail: { open: true } }));
    };

    const close = () => menu.close();

    menu.addEventListener('close', () => {
      window.clearInterval(clockTimer);
      document.dispatchEvent(new CustomEvent('menu:toggle', { detail: { open: false } }));
    });

    document.querySelectorAll('[data-menu-open]').forEach((btn) => btn.addEventListener('click', open));
    menu.querySelector('[data-menu-close]')?.addEventListener('click', close);
    // Close when a link is chosen (covers same-page anchors like #work)
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));

    // Close automatically if the window grows past phone width (the nav shows its links there).
    // Window-level listener, so drop the previous page's one first.
    resizeWatch?.abort();
    resizeWatch = new AbortController();
    window
      .matchMedia('(min-width: 641px)')
      .addEventListener('change', (e) => e.matches && menu.open && close(), { signal: resizeWatch.signal });
  }

  let resizeWatch: AbortController | undefined;

  document.addEventListener('astro:page-load', setupMenu);
</script>

<style>
  .menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: hidden;
    display: none;
    flex-direction: column;
    color: var(--text);
    background-color: var(--bg);
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: var(--grid-size) var(--grid-size);
  }

  .menu[open] {
    display: flex;
    animation: menu-in 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .menu::backdrop {
    background: transparent;
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-12px);
    }
  }

  :global(html:has(#mobile-menu[open])) {
    overflow: hidden;
  }

  /* Abstract decoration */
  .deco {
    position: absolute;
    pointer-events: none;
  }

  .deco--circle {
    right: -120px;
    bottom: -120px;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: var(--orange);
  }

  .deco--arch {
    left: -40px;
    bottom: 80px;
    width: 130px;
    height: 170px;
    border-radius: var(--radius-pill) var(--radius-pill) 0 0;
    background: var(--sky);
  }

  /* Top bar mirrors the nav dock */
  .bar {
    position: relative;
    margin: 16px var(--gutter) 0;
    height: 60px;
    padding: 0 8px 0 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-radius: var(--radius-pill);
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .brand {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 15px;
    letter-spacing: -0.02em;
  }

  .brand span {
    color: var(--orange);
  }

  .close-btn {
    width: var(--tap);
    height: var(--tap);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--dark);
    color: var(--on-dark);
  }

  /* Big numbered links */
  .list {
    position: relative;
    padding: 36px var(--gutter) 0;
    display: flex;
    flex-direction: column;
  }

  .list a {
    height: 92px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
  }

  .label {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }

  .num {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }

  .word {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 46px;
    letter-spacing: var(--tracking-tight);
  }

  .arrow {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line);
    background: var(--surface);
    transition: transform 0.2s;
  }

  .list a:hover .arrow {
    transform: rotate(45deg);
  }

  .list a[aria-current] .word {
    color: var(--orange);
  }

  .list a[aria-current] .arrow {
    border-color: var(--orange);
    background: var(--orange);
    color: var(--dark);
  }

  /* Status card + socials */
  .bottom {
    position: relative;
    margin-top: auto;
    padding: 0 var(--gutter) 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .status {
    padding: 16px 18px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-radius: 24px;
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .status-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .mono {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--muted);
  }

  .status-title {
    font-weight: 600;
    font-size: 15px;
  }

  .toggle {
    width: 44px;
    height: 26px;
    padding: 3px;
    display: flex;
    border-radius: var(--radius-pill);
    background: var(--line);
  }

  .toggle.is-on {
    justify-content: flex-end;
    background: var(--success);
  }

  .toggle span {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--surface);
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .socials a {
    height: var(--tap);
    padding: 0 16px;
    display: flex;
    align-items: center;
    border-radius: var(--radius-pill);
    background: var(--dark);
    color: var(--on-dark);
    font-size: 14px;
  }

  /* The dialog sits in the top layer, above the page grain, so it needs its own */
  .menu-grain {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: url('/images/grain.png');
    background-size: 140px 140px;
    opacity: var(--grain-opacity);
    mix-blend-mode: multiply;
  }
</style>
