---
// "What it does": key capabilities as pastel cards.
interface Props {
  items: { title: string; text: string }[];
}

const { items } = Astro.props;
const tones = ['var(--note-peach)', 'var(--sky)', 'var(--note-lime)', 'var(--note-lilac)', 'var(--note-butter)'];
---

<section class="highlights" aria-labelledby="highlights-title">
  <div class="head" data-reveal>
    <h2 id="highlights-title">What it does</h2>
    <span>The key things it does for people.</span>
  </div>
  <ul class="grid" style={`--count: ${items.length}`}>
    {
      items.map((item, i) => (
        <li style={`--tone: ${tones[i % tones.length]}`} data-reveal data-reveal-delay={String(i * 0.06)}>
          <span class="num">{String(i + 1).padStart(2, '0')}</span>
          <div class="text">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .highlights {
    padding: 0 var(--gutter) 104px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
  }

  h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 64px;
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .head span {
    font-size: 17px;
    color: var(--muted);
  }

  .grid {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(min(var(--count), 4), minmax(0, 1fr));
    gap: 16px;
  }

  .grid li {
    min-height: 260px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
    border-radius: 32px;
    background: var(--tone);
    color: var(--dark);
    transition: transform 0.25s;
  }

  .grid li:hover {
    transform: translateY(-4px) rotate(-0.5deg);
  }

  .num {
    font-family: var(--font-mono);
    font-size: 12px;
    opacity: 0.6;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 24px;
    line-height: 1.1;
    letter-spacing: -0.035em;
  }

  p {
    font-size: 15px;
    line-height: 1.5;
    color: #3f3d39;
  }

  @media (max-width: 1023px) {
    .highlights {
      padding-bottom: 80px;
    }

    .head {
      flex-direction: column;
      align-items: flex-start;
    }

    h2 {
      font-size: 52px;
    }

    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .grid li {
      min-height: 220px;
    }
  }

  @media (max-width: 640px) {
    .highlights {
      padding-bottom: 56px;
      gap: 24px;
    }

    h2 {
      font-size: 36px;
    }

    .head span {
      font-size: 15px;
    }

    .grid {
      gap: 10px;
    }

    .grid li {
      min-height: 190px;
      padding: 18px;
      gap: 16px;
      border-radius: 24px;
    }

    h3 {
      font-size: 17px;
    }

    p {
      font-size: 13px;
    }
  }
</style>
