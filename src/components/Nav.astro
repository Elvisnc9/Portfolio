---
import Icon from './Icon.astro';
import MobileMenu from './MobileMenu.astro';
import { navLinks, site, type NavLabel } from '../data/site';

interface Props {
  active?: NavLabel;
  /** "talk" = orange Let's talk button, "email" = outline email pill (contact page) */
  cta?: 'talk' | 'email';
}

const { active, cta = 'talk' } = Astro.props;
---

<header class="site-header">
  <div class="dock">
    <a class="brand" href="/" aria-label="Elves Corps, home">ELVES<span>·</span>CORPS</a>

    <nav class="links" aria-label="Main">
      {
        navLinks.map((link) => (
          <a href={link.href} aria-current={link.label === active ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="actions">
      {
        cta === 'email' ? (
          <a class="cta cta--email" href={`mailto:${site.email}`}>{site.email}</a>
        ) : (
          <a class="cta cta--talk" href="/contact" data-magnetic>
            Let's talk <Icon name="arrow-up-right" />
          </a>
        )
      }
      <button
        class="menu-btn"
        type="button"
        aria-label="Open menu"
        aria-haspopup="dialog"
        aria-controls="mobile-menu"
        data-menu-open
      >
        <Icon name="menu" size={18} />
      </button>
    </div>
  </div>
</header>

<MobileMenu active={active} />

<style>
  .site-header {
    padding: 24px var(--gutter) 0;
  }

  .dock {
    height: 64px;
    padding: 0 10px 0 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border-radius: var(--radius-pill);
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .brand {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 18px;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .brand span {
    color: var(--orange);
  }

  .links {
    display: flex;
    gap: 4px;
    font-size: 15px;
  }

  .links a {
    padding: 10px 18px;
    border-radius: var(--radius-pill);
    color: var(--muted);
    transition: background-color 0.2s, color 0.2s;
  }

  .links a:hover,
  .links a[aria-current='page'] {
    background: var(--surface-2);
    color: var(--text);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .cta {
    height: var(--tap);
    padding: 0 22px;
    display: flex;
    align-items: center;
    gap: 8px;
    border-radius: var(--radius-pill);
    font-size: 15px;
    white-space: nowrap;
    transition: transform 0.2s;
  }

  .cta:hover {
    transform: translateY(-1px);
  }

  .cta--talk {
    background: var(--orange);
    color: var(--dark);
    font-weight: 600;
  }

  .cta--email {
    border: 1px solid var(--line);
    font-weight: 500;
  }

  .menu-btn {
    display: none;
    width: var(--tap);
    height: var(--tap);
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line);
    background: transparent;
  }

  /* Tablet: links move into the menu, CTA drops its arrow */
  @media (max-width: 1023px) {
    .site-header {
      padding-top: 20px;
    }

    .brand {
      font-size: 17px;
    }

    .links {
      display: none;
    }

    .menu-btn {
      display: flex;
    }

    .cta {
      padding: 0 20px;
    }

    .cta--talk :global(svg) {
      display: none;
    }
  }

  /* Mobile: only the orange menu button */
  @media (max-width: 640px) {
    .site-header {
      padding-top: 16px;
    }

    .dock {
      height: 60px;
      padding: 0 8px 0 18px;
    }

    .brand {
      font-size: 15px;
    }

    .cta {
      display: none;
    }

    .menu-btn {
      border: 0;
      background: var(--orange);
      color: var(--dark);
    }
  }
</style>
