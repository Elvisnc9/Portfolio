---
// The whole site is this one page. Nav links scroll to #work, #about, #notes, #contact.
// Only case studies (/work/[slug]) and notes (/notes/[slug]) are separate pages.
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Ribbons from '../components/home/Ribbons.astro';
import Work from '../components/home/Work.astro';
import AboutHero from '../components/about/AboutHero.astro';
import AboutStats from '../components/about/AboutStats.astro';
import Services from '../components/about/Services.astro';
import Certificates from '../components/about/Certificates.astro';
import Journey from '../components/about/Journey.astro';
import Testimonials from '../components/home/Testimonials.astro';
import NotesSection from '../components/notes/NotesSection.astro';
import ContactSection from '../components/contact/ContactSection.astro';
---

<BaseLayout>
  <Hero />
  <Ribbons />
  <Work />

  <div id="about" class="about-section">
    <AboutHero />
    <AboutStats />
    <Services />
    <Certificates />
    <Journey />
  </div>

  <Testimonials />
  <NotesSection />
  <ContactSection />
</BaseLayout>
