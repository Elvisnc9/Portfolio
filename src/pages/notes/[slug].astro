---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackLink from '../../components/BackLink.astro';
import Sparkle from '../../components/Sparkle.astro';
import StickyNote from '../../components/notes/StickyNote.astro';
import NotesCta from '../../components/notes/NotesCta.astro';
import { getNotes, noteNumber, type Note } from '../../lib/notes';

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note, i) => ({
    params: { slug: note.id },
    props: {
      note,
      // Wrap around so every note has a previous and next
      prev: notes[(i - 1 + notes.length) % notes.length],
      next: notes[(i + 1) % notes.length],
    },
  }));
}

interface Props {
  note: Note;
  prev: Note;
  next: Note;
}

const { note, prev, next } = Astro.props;
const { Content } = await render(note);
const { n, title, category, excerpt, color, pinned } = note.data;
---

<BaseLayout title={title} active="Notes" description={excerpt}>
  <section class="note-page">
    <BackLink href="/#notes" label="All notes" />

    <article class="note" style={`--note-bg: ${color}`} data-reveal>
      <span class="tape" aria-hidden="true"></span>
      <Sparkle class="note-spark" size={48} color="var(--orange)" />

      <div class="tags">
        {pinned && <span class="tag tag--dark">PINNED</span>}
        <span class="tag">NOTE {noteNumber(n)}</span>
        <span class="tag">{category.toUpperCase()}</span>
      </div>

      <h1>{title}</h1>

      <div class="body">
        <Content />
      </div>

      <p class="sign">Elvis, from Nigeria</p>
    </article>
  </section>

  <section class="more" aria-labelledby="more-title">
    <h2 id="more-title" class="more-title">Keep reading</h2>
    <div class="more-grid">
      <div class="more-item">
        <span class="more-label">PREVIOUS NOTE</span>
        <StickyNote note={prev} />
      </div>
      <div class="more-item">
        <span class="more-label">NEXT NOTE</span>
        <StickyNote note={next} delay={0.08} />
      </div>
    </div>
  </section>

  <NotesCta />
</BaseLayout>

<style>
  .note-page {
    max-width: 940px;
    margin: 0 auto;
    padding: 48px var(--gutter) 72px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  /* ---------- The note ---------- */
  .note {
    position: relative;
    padding: 64px 64px 56px;
    display: flex;
    flex-direction: column;
    gap: 28px;
    border-radius: 8px;
    background: var(--note-bg);
    color: var(--dark);
    box-shadow: 0 24px 60px rgba(17, 17, 16, 0.16);
    transform: rotate(-0.6deg);
  }

  .tape {
    position: absolute;
    left: 50%;
    top: -14px;
    width: 130px;
    height: 30px;
    margin-left: -65px;
    background: rgba(255, 255, 255, 0.6);
    transform: rotate(-3deg);
  }

  .note :global(.note-spark) {
    position: absolute;
    right: 44px;
    top: 44px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag {
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(17, 17, 16, 0.25);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .tag--dark {
    border-color: var(--dark);
    background: var(--dark);
    color: var(--on-dark);
  }

  h1 {
    max-width: 700px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 64px;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .body {
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .body :global(p) {
    font-size: 21px;
    line-height: 1.65;
    color: #3f3d39;
  }

  .body :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .sign {
    padding-top: 20px;
    border-top: 1px solid rgba(17, 17, 16, 0.15);
    font-family: var(--font-mono);
    font-size: 12px;
    opacity: 0.65;
  }

  /* ---------- Keep reading ---------- */
  .more {
    max-width: 940px;
    margin: 0 auto;
    padding: 0 var(--gutter) 96px;
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .more-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 44px;
    letter-spacing: -0.05em;
  }

  .more-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
  }

  .more-item {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .more-label {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }

  @media (max-width: 1023px) {
    .note {
      padding: 56px 44px 44px;
    }

    h1 {
      font-size: 52px;
    }
  }

  @media (max-width: 640px) {
    .note-page {
      padding: 24px var(--gutter) 48px;
      gap: 28px;
    }

    .note {
      margin: 0 4px;
      padding: 40px 24px 28px;
      gap: 20px;
      box-shadow: 0 20px 44px rgba(17, 17, 16, 0.16);
    }

    .tape {
      top: -12px;
      width: 100px;
      height: 26px;
      margin-left: -50px;
    }

    .note :global(.note-spark) {
      display: none;
    }

    .tag {
      padding: 5px 10px;
      font-size: 10px;
    }

    h1 {
      font-size: 34px;
      line-height: 1.02;
    }

    .body :global(p) {
      font-size: 17px;
      line-height: 1.6;
    }

    .more {
      padding: 0 20px 56px;
      gap: 24px;
    }

    .more-title {
      font-size: 30px;
    }

    .more-grid {
      gap: 16px;
    }

    .more-item {
      gap: 16px;
    }

    .more-label {
      font-size: 10px;
    }
  }
</style>
